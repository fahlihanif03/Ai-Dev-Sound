{
  "name": "web-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "backend:check": "tsc -p backend/tsconfig.json",
    "backend:dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "pages:dev": "npm run build && wrangler pages dev --cwd pages",
    "pages:deploy": "npm run build && wrangler pages deploy --cwd pages"
  },
  "dependencies": {
    "hono": "^4.13.7",
    "pinia": "^4.0.3",
    "three": "^0.185.1",
    "vue": "^3.5.41",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "wrangler": "^4.129.1"
  }
}
